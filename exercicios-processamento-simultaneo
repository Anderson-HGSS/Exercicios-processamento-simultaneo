#lang racket

(define (concatena lst1 lst2)
  (cond
   [(empty? lst1) lst2]
   [else
    (cons (first lst1) (concatena (rest lst1) lst2))]))

(define (+p lst1 lst2)
  (cond
    [(and (empty? lst1) (empty? lst2)) 0]
    [else
     (+ (* (first lst1) (first lst2)) (+p (rest lst1) (rest lst2)))]))

(define (prefixo lst1 lst2)
  (cond
    [(empty? lst1) #t]
    [(empty? lst2) #f]
    [else
     (cond
       [(equal? (first lst1) (first lst2)) (prefixo (rest lst1) (rest lst2))]
       [else
        #f])]))